# This file is read by Prisma when commands run from apps/server.
# Copy it to apps/server/.env only when preparing a PostgreSQL database.
DATABASE_URL=postgresql://cyberquest:cyberquest@localhost:5432/cyberquest?schema=public
DATA_BACKEND=prisma
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
ATTEMPT_HASH_SECRET=replace_with_a_different_long_random_secret
